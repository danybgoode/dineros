{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dineros",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "dineros.despachobonsai.com", "custom_domain": true }
  ]
}
